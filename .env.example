# Guttora needs no secrets.
# Drip detection, the impact math and the repair list all run in the browser,
# with no API keys and no outbound calls.

# Which adapter serves the pages: "fake" (seed only) or "real".
# "real" runs the same drip detector over the six synthetic bench clips on the server,
# so /notes arrives with counted numbers. The residence and grid factors stay seed in both modes.
# The farm runner sets this value at deploy; locally it defaults to fake.
ADAPTER_MODE=fake

# Set by next.config.ts at build time from public/brand/*.png. Leave empty.
NEXT_PUBLIC_BRAND_FILES=
