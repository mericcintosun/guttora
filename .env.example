# Guttora needs no secrets.
# Drip detection, the impact math and the repair list all run in the browser,
# with no API keys and no server calls.

# Which adapter serves the residence, grid factors and bench clips: "fake" (seed) or "real".
# Today "real" delegates to the seed as well.
ADAPTER_MODE=fake

# Set by next.config.ts at build time from public/brand/*.png. Leave empty.
NEXT_PUBLIC_BRAND_FILES=
